# ==============================================================================
# SongNhat AI-02 — Predictive Lead Prioritization (.env.example)
# ==============================================================================
# Hướng dẫn: Sao chép file này thành `.env` trên máy cục bộ / môi trường triển khai
# và điền bí mật thực tế. TUYỆT ĐỐI KHÔNG commit file `.env` thật lên Git
# (đã bị chặn bởi `.gitignore` và `.pre-commit-config.yaml` / gitleaks).
# ==============================================================================

# 1. Tách biệt môi trường (SEC-06 / PLPT-55): development | evaluation | production
ENV_MODE=development

# 2. Đường dẫn cơ sở dữ liệu SQLite & thư mục Quarantine (tách riêng theo môi trường)
DATABASE_PATH=data/songnhat.db
QUARANTINE_DIR=data/quarantine
ENQUIRIES_CSV_PATH=data/raw/enquiries_snapshot.csv
OUTCOMES_CSV_PATH=data/raw/outcome_events.csv
QUARANTINE_ROWS_PATH=data/quarantine/quarantine_rows.csv
QUARANTINE_OUTCOMES_PATH=data/quarantine/quarantine_outcomes.csv
CORS_ALLOWED_ORIGINS=http://localhost,http://127.0.0.1

# 3. Quản lý bí mật & phiên đăng nhập 5 vai trò RBAC (SEC-01 / SEC-06 / PLPT-55)
# Thay bằng chuỗi ngẫu nhiên bảo mật (>= 32 ký tự) khi chạy ngoài môi trường dev
SESSION_SECRET_KEY=CHANGE_ME_LOCAL_DEV_PLACEHOLDER_ONLY
SESSION_TTL_MINUTES=60
MAX_CONCURRENT_SESSIONS=5
RBAC_ENFORCE_V1=true
RBAC_ENFORCE_LEGACY=true

# 4. Khóa chiến lược Rules-First & Cổng Gate G1 (PLPT-56)
# Chỉ chuyển sang PREDICTIVE_ML khi dữ liệu REAL vượt qua Gate G1 và được Model Reviewer ký duyệt
ACTIVE_SCORING_MODE=RULES_BASELINE
GATE_G1_APPROVED=false

# 5. Tham số vận hành hàng đợi & Lịch Việt Nam (US-01 / PLPT-24)
DAILY_CAPACITY_K=25
VN_HOLIDAYS_FILE=

